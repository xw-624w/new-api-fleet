# Local build variant of the rc.39 Dockerfile.
#
# 与上游差异（刻意保留，均有原因）：
#   1. GOPROXY -> goproxy.cn, GOSUMDB off, GOTOOLCHAIN local：本机访问不了
#      proxy.golang.org / sum.golang.org。
#   2. 运行时用 debian:bookworm-slim（按 digest 固定），不再 FROM calciumion/new-api:latest。
#      原因见下，这是之前镜像膨胀到 4.1GB 的根因。
#   3. VERSION 在本 tag 为空，版本号回落到 BUILD_VERSION。
#
# 【为什么不再复用生产镜像当基础层】
# 旧写法 FROM calciumion/new-api:latest，而每次部署又会把新镜像重新打成
# calciumion/new-api:latest，于是下一次构建就在"上一次的产物"上再叠一层 139MB 的
# 二进制 —— 镜像像滚雪球一样越滚越大（1.4 → 4.1GB），并且每次构建都带上了历史所有
# 旧版本二进制的垃圾层。运行时只需要 debian + CA 证书 + tzdata，从干净基础构建即可。

FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS builder

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY ./web ./
COPY ./VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS builder2
ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=off
ENV GOTOOLCHAIN=local

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
ADD relaykit/go.mod ./relaykit/go.mod
RUN go mod download

COPY . .
COPY --from=builder /build/web/dist ./web/dist
ARG BUILD_VERSION=v1.0.0-rc.39
RUN V="$(cat VERSION 2>/dev/null)"; [ -n "$V" ] || V="$BUILD_VERSION"; \
    go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$V'" -o new-api && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w" -o /build/fleet-agent ./cmd/fleet-agent

# 干净运行时：debian:bookworm-slim + CA 证书 + 时区数据（与上游一致）
FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder2 /build/new-api /new-api
# 采集端二进制：供 /api/fleet/agent/bin 下发，实现一条命令安装
COPY --from=builder2 /build/fleet-agent /fleet-agent-bin

EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
