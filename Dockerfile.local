# Local build variant of the v1.0.0-rc.49 Dockerfile.
#
# 与上游差异（刻意保留，均有原因）：
#   1. GOPROXY -> goproxy.cn, GOSUMDB off, GOTOOLCHAIN local：本机访问不了
#      proxy.golang.org / sum.golang.org。
#   2. 运行时用 debian:bookworm-slim（按 digest 固定），不再 FROM calciumion/new-api:latest。
#      原因：复用生产镜像当基础层会把每次构建的 139MB 二进制叠进历史，镜像膨胀到 4.1GB。
#   3. 额外构建 fleet-agent 并打进镜像，供 /api/fleet/agent/bin 下发。
#   4. 去掉 PGO：PGO 需要 moejs 的 default.pgo 与 go 工具链完全匹配，
#      本地隔离网络环境下容易失败；功能不受影响，只损失一点性能。

FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS builder

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY ./web ./
COPY ./VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

FROM golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS builder2
ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=off
ENV GOTOOLCHAIN=local

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
ADD relaykit/go.mod ./relaykit/go.mod
ADD tokenkit/go.mod ./tokenkit/go.mod
RUN go mod download

COPY . .
COPY --from=builder /build/web/dist ./web/dist
RUN V="$(cat VERSION 2>/dev/null)"; [ -n "$V" ] || V="v1.0.0-rc.49"; \
    go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$V'" -o new-api && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w" -o /build/fleet-agent ./fleet/cmd/fleet-agent

# 干净运行时：debian:bookworm-slim + CA 证书 + 时区数据（与上游一致）
FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder2 /build/new-api /new-api
# 采集端二进制：供 /api/fleet/agent/bin 下发，实现一条命令安装
COPY --from=builder2 /build/fleet-agent /fleet-agent-bin

COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
